rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ['admin', 'superadmin'];
    }
    
    match /leads/{docId} { allow read, write: if isSignedIn(); }
    match /users/{docId} { allow read, write: if isSignedIn(); }
    match /tasks/{docId} { allow read, write: if isSignedIn(); }
    match /projects/{docId} { allow read, write: if isSignedIn(); }
    match /followups/{docId} { allow read, write: if isSignedIn(); }
    match /notifications/{docId} { allow read, write: if isSignedIn(); }
    match /vendors/{docId} { allow read, write: if isSignedIn(); }
    match /attendance/{docId} { allow read, write: if isSignedIn(); }
    // Staff profiles hold Aadhar / bank details: admins can read everyone's,
    // an employee can read and (while still a draft) write only their own.
    match /staffProfiles/{docId} {
      allow read: if isAdmin() || (isSignedIn() && docId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && docId == request.auth.uid
        && request.resource.data.profileStatus in ['draft', 'submitted']);
      allow update: if isAdmin() || (isSignedIn() && docId == request.auth.uid
        && request.resource.data.profileStatus in ['draft', 'submitted']
        && resource.data.get('profileStatus', 'draft') == 'draft');
      allow delete: if isAdmin();
    }
    match /counters/{docId} { allow read, write: if isSignedIn(); }
    match /contacts/{docId} { allow read, write: if isSignedIn(); }
    
    // Campaign Sender
    match /campaigns/{docId} { allow read, write: if isSignedIn(); }
    match /campaign_batches/{docId} { allow read, write: if isSignedIn(); }
    match /wa_campaigns/{docId} { allow read, write: if isSignedIn(); }
    // Maps a WhatsApp template name to a reusable send-time media id, so a
    // template with an image header can actually be sent (Meta requires a
    // header parameter in the send request whenever the template defines
    // an image header, separate from the one-time upload handle used when
    // the template was created).
    match /wa_template_headers/{docId} { allow read, write: if isSignedIn(); }
    
    // Sensitive settings (API keys) - any signed-in user can read (needed to trigger
    // notifications/campaigns from the app), only admins can change the keys
    match /settings/{docId} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // WhatsApp webhook (cf-worker/worker.js) writes here using only the public
    // Firebase Web API key, with no auth token - it can't satisfy isSignedIn().
    // Read stays restricted to signed-in staff viewing the inbox.
    match /whatsapp_messages/{docId} { allow read: if isSignedIn(); allow write: if true; }
    match /whatsapp_status_updates/{docId} { allow read: if isSignedIn(); allow write: if true; }

    match /{document=**} { allow read, write: if false; }
  }
}
